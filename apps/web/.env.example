# Copy this file to ".env" and fill in your own values.
# Both values below are PUBLIC-safe (no secrets). They can be committed if you want,
# but .env is gitignored by default so you don't have to.

# OAuth Client ID from Google Cloud Console (Web application, no client secret).
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The spreadsheet ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
VITE_SPREADSHEET_ID=1cnkweKJ-g9ds2kJ5YeXH4Te65Nx5KabcPVJ1mTQFhA4

# The exact tab/sheet name to read.
VITE_SHEET_NAME=Switzerland
