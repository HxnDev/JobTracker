# Android OAuth Client ID from Google Cloud Console (type: Android, no secret).
# Created with package name com.hxndev.jobtracker + the SHA-1 from EAS credentials.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional overrides — defaults come from @jobtracker/shared.
# EXPO_PUBLIC_SPREADSHEET_ID=
# EXPO_PUBLIC_SHEET_NAME=Switzerland
